# Tech Challenge Fase 3 — Assistente Médico
# Copie para .env: cp .env.example .env

# ── Backend da LLM do assistente: mlx | ollama | stub ─────────────
# Padrao (sem esta variavel): usa o adapter fine-tuned MLX se existir;
# senao Ollama (se OLLAMA_MODEL definido); senao stub offline.
# FASE3_LLM_BACKEND=mlx

# Modelo base para fine-tuning/inferencia MLX (Apple Silicon):
# FASE3_BASE_MODEL=mlx-community/Llama-3.2-1B-Instruct-4bit

LLM_TEMPERATURE=0.1

# ── Ollama (backend alternativo, sem fine-tuning) ─────────────────
# Modelos recomendados:
#   phi3:mini (~2.3 GB) | llama3.2:3b (~2.0 GB) | qwen2.5:3b (~2.0 GB)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT=180
